# Required
OPENROUTER_API_KEY=''
QDRANT_API_KEY=''
QDRANT_URL=''

# Optional: Cohere reranking (leave empty or set USE_RERANKER=false to skip)
COHERE_API_KEY=''
USE_RERANKER=true

# Models (OpenRouter ids). EMBEDDING_MODEL must match the vectors uploaded to Qdrant.
EMBEDDING_MODEL=baai/bge-large-en-v1.5
LLM_MODEL=openai/gpt-4.1-mini
REFINEMENT_MODEL=openai/gpt-4o-mini

# Generation
TEMPERATURE=0.1
MAX_TOKENS=2000
REFINE_QUERY=true
RETRIEVAL_TOP_K=8

CHUNKS_PATH=./chunks.json
